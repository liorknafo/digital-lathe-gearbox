      ["so1_y", "motor_y + so_h * sin(motor_angle) - so_h * cos(motor_angle)", "mm", ""],
      ["so2_x", "motor_x - so_h * cos(motor_angle) + so_h * sin(motor_angle)", "mm", "standoff 2 (the bolt square turned with the motor)"],
      ["so2_y", "motor_y + so_h * sin(motor_angle) + so_h * cos(motor_angle)", "mm", ""],
      ["so3_x", "motor_x + so_h * cos(motor_angle) - so_h * sin(motor_angle)", "mm", "standoff 3 (the bolt square turned with the motor)"],
      ["so3_y", "motor_y - so_h * sin(motor_angle) - so_h * cos(motor_angle)", "mm", ""],
      ["so4_x", "motor_x + so_h * cos(motor_angle) + so_h * sin(motor_angle)", "mm", "standoff 4 (the bolt square turned with the motor)"],
      ["so4_y", "motor_y - so_h * sin(motor_angle) + so_h * cos(motor_angle)", "mm", ""],
      ["mc1_x", "motor_x - motor_body / 2 * cos(motor_angle) - motor_body / 2 * sin(motor_angle)", "mm", "motor flange corner 1"],
      ["mc1_y", "motor_y + motor_body / 2 * sin(motor_angle) - motor_body / 2 * cos(motor_angle)", "mm", ""],
      ["mc2_x", "motor_x + motor_body / 2 * cos(motor_angle) - motor_body / 2 * sin(motor_angle)", "mm", "motor flange corner 2"],
      ["mc2_y", "motor_y - motor_body / 2 * sin(motor_angle) - motor_body / 2 * cos(motor_angle)", "mm", ""],
      ["mc3_x", "motor_x + motor_body / 2 * cos(motor_angle) + motor_body / 2 * sin(motor_angle)", "mm", "motor flange corner 3"],
      ["mc3_y", "motor_y - motor_body / 2 * sin(motor_angle) + motor_body / 2 * cos(motor_angle)", "mm", ""],
      ["mc4_x", "motor_x - motor_body / 2 * cos(motor_angle) + motor_body / 2 * sin(motor_angle)", "mm", "motor flange corner 4"],
      ["mc4_y", "motor_y + motor_body / 2 * sin(motor_angle) + motor_body / 2 * cos(motor_angle)", "mm", ""],
      ["col_cx", "enc_x + enc_travel / 2", "mm", "centre of the cup's +X end circle"],
      ["col_rr", "eb_out - eb_col_r - 0.2 mm", "mm", "M4 column radius from col_cx"],
      ["col_x", "col_cx + col_rr * cos(eb_col_ang)", "mm", "M4 columns at (col_x, enc_y +- col_dy)"],
      ["col_dy", "col_rr * sin(eb_col_ang)", "mm", ""],
      ["cup_left_x", "enc_x - enc_travel / 2 - eb_left", "mm", "open end of the cup"],
      ["arm_ay", "B1_y + base_travel / 2", "mm", "arm from (B1_x, arm_ay) to (col_cx, enc_y)"],
      ["arm_len", "sqrt((col_cx - B1_x)^2 + (enc_y - arm_ay)^2)", "mm", ""],
      ["win_t0", "base_boss_r + 10 mm + base_window_w / 2", "mm", "lightening window along the arm, from t0"],
      ["win_t1", "arm_len - (eb_out + base_pad_margin + 6 mm) - base_window_w / 2", "mm", "to t1"]
    ]},
    {"group": "DERIVED: door windows (anything past the closed door goes through a window; the far edge clears the swing)", "params": [
