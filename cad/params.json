      ["m_swing_x", "door_hinge_x + sqrt(max(0 mm * mm, (mbox_x1 - door_hinge_x)^2 + (motor_front_z - door_hinge_z)^2 - (door_depth - door_hinge_z)^2))", "mm", "where the far window edge must be so the door swings past the motor's outer back corner"],
      ["mwin_x0", "mbox_x0 - door_cut_clear - door_cable_gap", "mm", "motor window"],
      ["mwin_x1", "max(mbox_x1 + door_cut_clear, m_swing_x + door_swing_margin)", "mm", ""],
      ["mwin_y0", "mbox_y0 - door_cut_clear_y", "mm", ""],
      ["mwin_y1", "mbox_y1 + door_cut_clear_y", "mm", ""],
      ["ebox_x0", "enc_x - enc_body_d / 2", "mm", "encoder body box in XY"],
