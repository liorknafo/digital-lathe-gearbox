      ["eb_under_z", "enc_face_z - eb_top_t", "mm", "top plate underside"],
      ["enc_belt_lo", "stud_belt_mid_z - enc_belt_w / 2", "mm", ""],
      ["enc_belt_hi", "stud_belt_mid_z + enc_belt_w / 2", "mm", ""],
      ["ov_60", "max(0 mm, min(enc_belt_hi, stud_z0 + gt2_flange_t + gt2_tooth_len) - max(enc_belt_lo, stud_z0 + gt2_flange_t))", "mm", ""],
      ["ov_e20", "max(0 mm, min(enc_belt_hi, ep_back_z + gt2_flange_t + gt2_tooth_len) - max(enc_belt_lo, ep_back_z + gt2_flange_t))", "mm", ""]
    ]},
    {"group": "DERIVED: plate and bracket planform", "params": [
      ["plate_x_max", "panel_right_x - panel_margin", "mm", ""],
