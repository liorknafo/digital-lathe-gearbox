      ["ov_40", "max(0 mm, min(belt_hi, ls_belt_mid_z + htd_tooth_len / 2) - max(belt_lo, ls_belt_mid_z - htd_tooth_len / 2))", "mm", "HTD belt on the 40T teeth"],
      ["ov_20", "max(0 mm, min(belt_hi, mp_back_z + mp_buy_flange + mp_buy_tooth) - max(belt_lo, mp_back_z + mp_buy_flange))", "mm", "HTD belt on the 20T teeth"],
      ["ep_len", "gt2_flange_t + gt2_tooth_len + ep_hub_len", "mm", "20T GT2 overall"],
      ["ep_back_z", "stud_belt_mid_z - (gt2_flange_t + gt2_tooth_len / 2)", "mm", "its toothed band on the stud's"],
      ["ep_front_z", "ep_back_z + ep_len", "mm", ""],
      ["enc_face_z", "ep_front_z + eb_pulley_gap + eb_top_t", "mm", "encoder mounting face = bracket top"],
      ["enc_tip_z", "enc_face_z - eb_recess - enc_shaft_len", "mm", ""],
      ["enc_engage", "ep_front_z - max(enc_tip_z, ep_back_z)", "mm", "pulley bore on the encoder shaft"],
      ["enc_front_z", "enc_face_z + enc_body_len", "mm", ""],
      ["eb_h", "enc_face_z - base_t", "mm", "bracket height above the plate"],
      ["eb_in", "enc_body_d / 2 + eb_clear", "mm", "half width inside the cup"],
