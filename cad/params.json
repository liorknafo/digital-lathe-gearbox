      ["e_swing_x", "door_hinge_x + sqrt(max(0 mm * mm, (ebox_x1 - door_hinge_x)^2 + (enc_front_z - door_hinge_z)^2 - (door_depth - door_hinge_z)^2))", "mm", ""],
      ["ewin_x0", "ebox_x0 - door_cut_clear - door_cable_gap", "mm", "encoder window"],
      ["ewin_x1", "max(ebox_x1 + door_cut_clear, e_swing_x + door_swing_margin)", "mm", ""],
      ["ewin_y0", "ebox_y0 - door_cut_clear_y", "mm", ""],
      ["ewin_y1", "ebox_y1 + door_cut_clear_y", "mm", ""]
    ]}
  ]
